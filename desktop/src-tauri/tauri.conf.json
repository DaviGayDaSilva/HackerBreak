{
  "$schema": "https://raw.githubusercontent.com/nickel-lang/json-schema-store/refs/heads/main/schemas/nickel/tauri-v2.schema.json",
  "productName": "Hacker Break",
  "identifier": "com.hackerbreak.app",
  "version": "1.0.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hacker Break - Cyber Defense",
        "width": 1024,
        "height": 768,
        "center": true,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "files": {}
      }
    }
  }
}